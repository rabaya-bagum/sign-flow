# Copy to .env and fill in. Only EXPO_PUBLIC_* values are bundled into the app, and they must be
# public: never put a service-role/secret key here.

# Local: printed by `npm run db:start` (API_URL and ANON_KEY / PUBLISHABLE_KEY).
# From a device or emulator use your machine's LAN IP instead of 127.0.0.1 (Android emulator: 10.0.2.2).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google sign-in (optional; the button is hidden until these are set). See README.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed iOS client ID, e.g. com.googleusercontent.apps.1234-abcd (used by the config plugin).
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Optional: override the placeholder bundle identifier / Android package.
# SIGNFLOW_BUNDLE_ID=com.example.signflow
