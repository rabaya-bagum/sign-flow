{
  "name": "signflow",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "test": "jest",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "gen:types": "supabase gen types typescript --local > src/types/database.ts",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:functions": "deno test -A --node-modules-dir=none supabase/functions/tests",
    "fixtures": "deno run --node-modules-dir=none -A scripts/generate-fixtures.ts",
    "functions:serve": "supabase functions serve",
    "functions:deploy": "supabase functions deploy process-upload get-download-url delete-draft",
    "build:surface": "node scripts/build-surface.mjs",
    "check:surface": "node scripts/build-surface.mjs --check",
    "check:dev-routes": "node scripts/check-dev-routes.mjs",
    "test:surface": "node --test tests/surface/surface.test.mjs",
    "test:golden": "deno run --node-modules-dir=none -A scripts/golden/generate-stamped.ts && node --test tests/surface/golden.test.mjs",
    "postinstall": "setup-skia-web public > /dev/null"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "aes-js": "^3.1.2",
    "expo": "~57.0.26",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.18",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-document-scanner-plugin": "^2.0.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "deno": "^2.9.6",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.3.289",
    "playwright": "1.56.1",
    "prettier": "^3.9.9",
    "react-test-renderer": "^19.2.3",
    "supabase": "^2.119.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@shared/(.*)$": "<rootDir>/shared/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/supabase/",
      "/integration/"
    ]
  }
}
