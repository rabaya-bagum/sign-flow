# Local Edge Function environment (copy to supabase/functions/.env; never commit secrets).
# Enables the dev-only dev-stamp function used by /dev/coordinate-spike. Never set on a hosted project.
DEV_TOOLS=true

# Email (send-document and later notifications). Production: set RESEND_API_KEY and EMAIL_FROM
# as function secrets. Local: Mailpit from the Supabase stack (read mail at http://127.0.0.1:54324).
MAILPIT_API_URL=http://supabase_inbucket_sign-flow:8025
# Origin of the web app that serves /s/<token> (guest signing, Phase 6).
PUBLIC_SIGNING_URL=http://localhost:8081
